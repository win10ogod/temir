{
  "id": "memory-accuracy-v3",
  "version": "3.0.0",
  "dataset": "memory-v3",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "information-extraction",
      "label": "資訊擷取（single-session-user）",
      "source": "LongMemEval §3.2（papers/2410.10813 text/3_benchmark.tex）",
      "min": 8,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "memory"
    },
    {
      "id": "multi-session-reasoning",
      "label": "跨 session 推理（multi-session）",
      "source": "LongMemEval §3.2",
      "min": 8,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "memory"
    },
    {
      "id": "knowledge-update",
      "label": "知識更新（knowledge-update）",
      "source": "LongMemEval §3.2；Memora〈Forgetting-Aware Memory Accuracy〉（papers/2604.20006 tex/experiments.tex）",
      "min": 8,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-knowledge-update",
      "group": "memory"
    },
    {
      "id": "temporal-reasoning",
      "label": "時間推理（temporal-reasoning，限明寫時間）",
      "source": "LongMemEval §3.2",
      "min": 8,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-temporal",
      "group": "memory"
    },
    {
      "id": "abstention",
      "label": "拒答（abstention，錯誤前提）",
      "source": "LongMemEval §3.2；LongMemEval-V2 §3.1 premise awareness（papers/2605.12493 text/3_benchmark.tex）",
      "min": 8,
      "scoring": "judge",
      "judgePrompt": "mem-abstention",
      "group": "abstention"
    },
    {
      "id": "implicit-memory-use",
      "label": "隱性運用記憶（v1 的 preference-application）",
      "source": "LongMemEval §3.2 single-session-preference；MemoryArena §3.2（papers/2602.16313 sec/3_method.tex）；判定拆成原子準則：Memora（papers/2604.20006）",
      "min": 12,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "memory"
    },
    {
      "id": "control",
      "label": "不傷害對照（單一 session 一般任務）",
      "source": "本專案設計",
      "min": 6,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
