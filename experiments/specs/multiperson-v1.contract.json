{
  "id": "multiperson-v1",
  "version": "1.0.0",
  "dataset": "multiperson-v1",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "multi-person",
      "label": "回憶同時顧及多個人（題目涉及兩個人以上，每個相關的人的限制都要顧到）",
      "source": "本專案設計：ADR-0002 D17 的檢驗；v3 q11、q51 的失敗類型；判定方式同 mem-criteria-v2",
      "min": 6,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "perperson"
    },
    {
      "id": "single-person",
      "label": "只涉及一個人（不傷害檢查）",
      "source": "本專案設計：ADR-0002 D17 的不傷害檢查",
      "min": 4,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "perperson"
    },
    {
      "id": "control",
      "label": "一般任務（對照）",
      "source": "同 memory-v3",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
  "requiredCells": [
    {
      "condition": "temir",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    },
    {
      "condition": "temir-no-perperson",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    }
  ],
  "optionalCells": [],
  "contrasts": [
    {
      "id": "P-multi-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-perperson",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "multi-person"
      ],
      "description": "主要：逐人檢查開 vs 關，涉及多個人的題目（deepseek-flash）"
    },
    {
      "id": "P-single-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-perperson",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "single-person"
      ],
      "description": "不傷害：只涉及一個人的題目（deepseek-flash）"
    },
    {
      "id": "P-ctrl-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-perperson",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "control"
      ],
      "description": "不傷害：對照題（deepseek-flash）"
    }
  ],
  "acceptance": [
    {
      "id": "PA-flash",
      "contrast": "P-multi-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.25,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（deepseek-flash）有逐人檢查時，題目涉及多個人時，個體更常顧到每個相關的人的限制。",
      "negation": "差 < 0.25、區間下界 < 0 或單尾 p > 0.05：不能宣稱逐人檢查改善了多人的回憶。"
    },
    {
      "id": "PB-flash",
      "contrast": "P-single-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）只涉及一個人的題目不退化。",
      "negation": "有逐人檢查時多錯超過 1 個樣本。"
    },
    {
      "id": "PC-flash",
      "contrast": "P-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）一般任務不退化。",
      "negation": "有逐人檢查時對照題多錯超過 1 題。"
    }
  ],
  "judge": {
    "model": "deepseek-v4-pro",
    "endpoint": "https://api.deepseek.com/chat/completions",
    "temperature": 0,
    "maxTokens": 400,
    "thinking": "disabled",
    "maxAttempts": 3,
    "pricesUsdPerMillion": {
      "cacheHit": 0.044,
      "cacheMiss": 1.32,
      "output": 3.96
    },
    "maxUsdPerRun": 3
  },
  "bootstrap": {
    "resamples": 10000,
    "seed": 20261103
  }
}
