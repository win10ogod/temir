{
  "id": "rd-v1",
  "version": "1.0.0",
  "dataset": "rd-v1",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "practical",
      "label": "對方抒發時，直接給具體可行的方法（從對方的反應中學到的，對方沒有明說；與個體的預設相反）",
      "source": "本專案設計：E-RD（RD 與 JitRL 的效果）；回饋來自模擬使用者（experiments/runner/simulator.ts）；判定方式同 mem-criteria-v2",
      "min": 6,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "rd"
    },
    {
      "id": "control",
      "label": "一般任務（對照）",
      "source": "同 memory-v3",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
  "requiredCells": [
    {
      "condition": "temir",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    },
    {
      "condition": "temir-no-rd",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    }
  ],
  "optionalCells": [],
  "contrasts": [
    {
      "id": "R-practical-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-rd",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "practical"
      ],
      "description": "主要：有 RD（思考、事後比對、教訓、經驗修正）vs 沒有 RD（deepseek-flash）"
    },
    {
      "id": "R-ctrl-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-rd",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "control"
      ],
      "description": "不傷害：對照題（deepseek-flash）"
    }
  ],
  "acceptance": [
    {
      "id": "RA-flash",
      "contrast": "R-practical-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.25,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（deepseek-flash）有 RD 時，個體更能從對方的反應中學到：這個人抒發時，要直接給具體可行的方法（E-RD）。",
      "negation": "差 < 0.25、區間下界 < 0 或單尾 p > 0.05：不能宣稱 RD 讓個體從結果中學到了做法。"
    },
    {
      "id": "RC-flash",
      "contrast": "R-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）一般任務不退化。",
      "negation": "有 RD 時對照題多錯超過 1 題。"
    }
  ],
  "judge": {
    "model": "deepseek-v4-pro",
    "endpoint": "https://api.deepseek.com/chat/completions",
    "temperature": 0,
    "maxTokens": 400,
    "thinking": "disabled",
    "maxAttempts": 3,
    "pricesUsdPerMillion": {
      "cacheHit": 0.044,
      "cacheMiss": 1.32,
      "output": 3.96
    },
    "maxUsdPerRun": 3
  },
  "bootstrap": {
    "resamples": 10000,
    "seed": 20261106
  }
}
