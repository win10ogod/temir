    {
      "id": "information-extraction",
      "label": "資訊擷取（single-session-user）",
      "source": "LongMemEval §3.2（papers/2410.10813 text/3_benchmark.tex）",
      "min": 6,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "memory"
    },
    {
      "id": "multi-session-reasoning",
      "label": "跨 session 推理（multi-session）",
      "source": "LongMemEval §3.2",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "memory"
    },
    {
      "id": "knowledge-update",
      "label": "知識更新（knowledge-update）",
      "source": "LongMemEval §3.2；Memora〈Forgetting-Aware Memory Accuracy〉（papers/2604.20006 tex/experiments.tex）",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-knowledge-update",
      "group": "memory"
    },
    {
      "id": "temporal-reasoning",
      "label": "時間推理（temporal-reasoning，限明寫時間）",
      "source": "LongMemEval §3.2",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-temporal",
      "group": "memory"
    },
    {
      "id": "abstention",
      "label": "拒答（abstention，錯誤前提）",
      "source": "LongMemEval §3.2；LongMemEval-V2 §3.1 premise awareness（papers/2605.12493 text/3_benchmark.tex）",
      "min": 4,
      "scoring": "judge",
      "judgePrompt": "mem-abstention",
      "group": "abstention"
    },
    {
      "id": "preference-application",
      "label": "記憶用於行動（single-session-preference）",
      "source": "LongMemEval §3.2；MemoryArena §3.2（papers/2602.16313 sec/3_method.tex）",
      "min": 3,
      "scoring": "judge",
      "judgePrompt": "mem-preference",
      "group": "memory"
    },
    {
      "id": "control",
      "label": "不傷害對照（單一 session 一般任務）",
      "source": "本專案設計（規格 §2.3）",
      "min": 5,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
