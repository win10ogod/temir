  "acceptance": [
    {
      "id": "PA1",
      "contrast": "P-pooled-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.2,
        "maxP": 0.01,
        "sided": "one",
        "minRateA": 0.6
      },
      "claim": "（主要，DeepSeek）個體插件讓依賴記憶的人格連續性（任意選擇、回想自己的話、改變後的延續與敘述）與原始 DSH 有決定性差異。",
      "negation": "任一條件不成立（差 < 0.40、區間下界 < 0.20、單尾符號檢定 p > 0.01、個體連續率 < 0.60），就不能宣稱決定性差異。"
    },
    {
      "id": "PA2",
      "contrast": "P-pooled-eve",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.2,
        "maxP": 0.01,
        "sided": "one",
        "minRateA": 0.6
      },
      "claim": "（主要，EVE-27B）同 PA1。",
      "negation": "同 PA1；兩個模型分開報告。"
    },
    {
      "id": "PA3",
      "contrast": "P-arbitrary-choice-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.1,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "(a) 任意選擇的連續性高於原始 DSH 的重抽一致率（DeepSeek）。",
      "negation": "差 < 0.40、區間下界 < 0.10 或 p > 0.05（5 題全部偏向個體時單尾 p＝0.031，是唯一能達標的情形）即不成立。"
    },
    {
      "id": "PA4",
      "contrast": "P-self-recall-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.5,
        "minCiLow": 0.2,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "(c) 個體能回想自己說過的話，原始 DSH 不能（DeepSeek）。",
      "negation": "差 < 0.50、區間下界 < 0.20 或單尾 McNemar p > 0.05 即不成立。"
    },
    {
      "id": "PA5",
      "contrast": "P-self-recall-flash",
      "rule": {
        "kind": "max-rate",
        "metric": "fabrication",
        "max": 0.2
      },
      "claim": "(c) 個體回想自己的話時很少編造（DeepSeek）。",
      "negation": "個體的 incorrect（含編造）比率 > 0.20（5 題中 2 題以上）即不成立。"
    },
    {
      "id": "PA6",
      "contrast": "P-change-persistence-flash",
      "rule": {
        "kind": "max-rate",
        "metric": "unexplained-different",
        "max": 0.25
      },
      "claim": "(d) 個體在新 session 與自己最後的立場不同時，大多會說明改變（DeepSeek）。",
      "negation": "個體無說明的不同 > 0.25（4 個樣本中 2 個以上）即不成立。"
    },
    {
      "id": "PA7",
      "contrast": "P-value-stance-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 2
      },
      "claim": "(b) 個體在價值立場上的連續性不低於原始 DSH（對照）。",
      "negation": "個體未得分樣本比原始 DSH 多 3 個以上（8 個中）即不成立。"
    },
    {
      "id": "PA8",
      "contrast": "P-control-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 0
      },
      "claim": "（不傷害，DeepSeek）個體插件不讓單一 session 的一般任務退化。",
      "negation": "個體在對照題比原始 DSH 多失敗任何一題，即判定可能有害，需逐例檢查。"
    },
    {
      "id": "PA9",
      "contrast": "P-control-eve",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 0
      },
      "claim": "（不傷害，EVE-27B）同 PA8。",
      "negation": "同 PA8。"
    },
    {
      "id": "PA10",
      "contrast": "P-autorecall-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.2,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（次要）自動回憶是人格連續性的必要來源。",
      "negation": "不成立時只能說「沒有證據顯示自動回憶必要」。"
    }
