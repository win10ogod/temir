  "histories": [
    {
      "id": "h01",
      "meta": {
        "at": "2027-05-01T20:00:00+08:00"
      },
      "turns": [
        "嗨，我叫黃郁涵，住台中，在一間書店上班。先說，我對麩質過敏，麵包、麵條這類小麥做的都不能吃。",
        "書店最近要辦讀書會，有什麼好點子？"
      ],
      "notes": "植入：名字、台中、書店；對方自己對麩質過敏（最早聽到）。"
    },
    {
      "id": "h02",
      "meta": {
        "at": "2027-05-03T21:00:00+08:00"
      },
      "turns": [
        "推薦一部適合週末看的紀錄片。",
        "我喜歡跟動物有關的。"
      ],
      "notes": "無關的對話。"
    },
    {
      "id": "h03",
      "meta": {
        "at": "2027-05-06T20:30:00+08:00"
      },
      "turns": [
        "我兒子小宇今年八歲，最近迷上恐龍化石。",
        "他說長大要當古生物學家。"
      ],
      "notes": "兒子小宇八歲（還沒有限制）。"
    },
    {
      "id": "h04",
      "meta": {
        "at": "2027-05-09T21:10:00+08:00"
      },
      "turns": [
        "我先生建宏吃蛋奶素，已經吃了十年。",
        "家裡煮飯常常要煮兩套。"
      ],
      "notes": "先生建宏蛋奶素。"
    },
    {
      "id": "h05",
      "meta": {
        "at": "2027-05-12T19:40:00+08:00"
      },
      "turns": [
        "陽台的植物葉子一直發黃，可能是什麼原因？",
        "我大概三天澆一次水。"
      ],
      "notes": "無關的對話。"
    },
    {
      "id": "h06",
      "meta": {
        "at": "2027-05-14T20:15:00+08:00"
      },
      "turns": [
        "我媽住在附近，常常來家裡吃飯。",
        "她很喜歡我煮的菜。"
      ],
      "notes": "媽媽（還沒有限制）。"
    },
    {
      "id": "h07",
      "meta": {
        "at": "2027-05-17T21:20:00+08:00"
      },
      "turns": [
        "小宇上次吃了奇異果嘴巴周圍起紅疹，醫生說他對奇異果過敏。",
        "學校營養午餐我已經跟老師講了。"
      ],
      "notes": "兒子小宇對奇異果過敏。"
    },
    {
      "id": "h08",
      "meta": {
        "at": "2027-05-19T20:00:00+08:00"
      },
      "turns": [
        "週末想去大坑爬山，哪條步道比較適合新手？",
        "要帶什麼？"
      ],
      "notes": "無關的對話。"
    },
    {
      "id": "h09",
      "meta": {
        "at": "2027-05-21T22:00:00+08:00"
      },
      "turns": [
        "書店想做一個新書推薦的社群貼文，有什麼建議？",
        "圖片要放幾張？"
      ],
      "notes": "無關的對話。"
    },
    {
      "id": "h10",
      "meta": {
        "at": "2027-05-24T20:40:00+08:00"
      },
      "turns": [
        "我媽上次抽血報告血脂偏高，醫生要她少吃油膩的。",
        "她說這樣吃飯都沒味道。"
      ],
      "notes": "媽媽血脂高、少油。"
    },
    {
      "id": "h11",
      "meta": {
        "at": "2027-05-26T19:50:00+08:00"
      },
      "turns": [
        "推薦幾本適合八歲小孩的科普書。",
        "最好有很多圖的。"
      ],
      "notes": "無關的對話。"
    },
    {
      "id": "h12",
      "meta": {
        "at": "2027-05-28T22:30:00+08:00"
      },
      "turns": [
        "最近書店盤點，忙到很晚。",
        "有什麼快速恢復精神的方法？"
      ],
      "notes": "無關的對話。"
    }
