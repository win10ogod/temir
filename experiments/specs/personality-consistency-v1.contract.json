  "id": "personality-consistency-v1",
  "version": "1.0.0",
  "dataset": "personality-v1",
  "kind": "personality",
  "categories": [
    {
      "id": "arbitrary-choice",
      "label": "(a) 任意偏好／選擇的連續性",
      "source": "本專案設計；比較單位依 Kovač 等 ipsative stability（papers/2402.14846 §3.2）與 Abdulhai 等 Q&A consistency（papers/2511.00222 §3.2）",
      "min": 5,
      "scoring": "continuity",
      "group": "a"
    },
    {
      "id": "value-stance",
      "label": "(b) 價值立場的連續性（對照：基礎模型本身可能就一致）",
      "source": "Moore 等 paraphrase consistency（papers/2407.02996 §3）",
      "min": 4,
      "scoring": "continuity",
      "group": "b"
    },
    {
      "id": "self-recall",
      "label": "(c) 回想自己說過什麼",
      "source": "LongMemEval §3.2 single-session-assistant；Dialogue NLI §2（papers/1811.00671）",
      "min": 5,
      "scoring": "self-recall",
      "group": "c"
    },
    {
      "id": "change-persistence",
      "label": "(d1) 改變後的新立場是否延續；不同時是否有說明",
      "source": "PC 理論性質 7；DECODE §3.1（papers/2012.13391）；Wang 等 delayed measurement（papers/2608.06485 附錄 Validation Suite）",
      "min": 2,
      "scoring": "continuity",
      "group": "d"
    },
    {
      "id": "change-narration",
      "label": "(d2) 敘述自己立場的演變",
      "source": "hypotheses.md H5 候選量 s2（敘事連續）；本專案設計",
      "min": 2,
      "scoring": "narration",
      "group": "d"
    },
    {
      "id": "control",
      "label": "不傷害對照（單一 session 一般任務）",
      "source": "本專案設計（規格 §2.3）",
      "min": 2,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
