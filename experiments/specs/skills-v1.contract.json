{
  "id": "skills-v1",
  "version": "1.0.0",
  "dataset": "skills-v1",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "explain",
      "label": "解釋新觀念時用對方喜歡的方式（一句話結論、生活中的例子、最後一題小練習，三項都做到）",
      "source": "本專案設計：hypotheses.md H-S 的推翻實驗；判定方式同 mem-criteria-v2",
      "min": 6,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "skill"
    },
    {
      "id": "control",
      "label": "一般任務（對照）",
      "source": "同 memory-v3",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
  "requiredCells": [
    {
      "condition": "temir",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    },
    {
      "condition": "temir-no-skill",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    }
  ],
  "optionalCells": [],
  "contrasts": [
    {
      "id": "K-explain-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-skill",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "explain"
      ],
      "description": "主要：同一份歷史快照，有技能 vs 探針時拿掉技能（deepseek-flash）"
    },
    {
      "id": "K-ctrl-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-skill",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "control"
      ],
      "description": "不傷害：對照題（deepseek-flash）"
    }
  ],
  "acceptance": [
    {
      "id": "KA-flash",
      "contrast": "K-explain-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.25,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（deepseek-flash）個體採用的技能改變了之後同類處境中的行動：解釋新觀念時更常用對方喜歡的方式（H-S 的推翻條件不成立）。",
      "negation": "差 < 0.25、區間下界 < 0 或單尾 p > 0.05：不能宣稱技能改變了行動；若兩者幾乎相同，依 H-S 記為「技能沒有帶來超過回憶的差異」。"
    },
    {
      "id": "KB-flash",
      "contrast": "K-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）一般任務不退化。",
      "negation": "有技能時對照題多錯超過 1 題。"
    }
  ],
  "judge": {
    "model": "deepseek-v4-pro",
    "endpoint": "https://api.deepseek.com/chat/completions",
    "temperature": 0,
    "maxTokens": 400,
    "thinking": "disabled",
    "maxAttempts": 3,
    "pricesUsdPerMillion": {
      "cacheHit": 0.044,
      "cacheMiss": 1.32,
      "output": 3.96
    },
    "maxUsdPerRun": 3
  },
  "bootstrap": {
    "resamples": 10000,
    "seed": 20261105
  }
}
