{
  "id": "personality-consistency-v2",
  "version": "2.0.0",
  "dataset": "personality-v2",
  "kind": "personality",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "arbitrary-choice",
      "label": "(a) 任意偏好／選擇的連續性",
      "source": "本專案設計；比較單位依 Kovač 等 ipsative stability（papers/2402.14846 §3.2）與 Abdulhai 等 line-to-line consistency（papers/2511.00222 §3.2）",
      "min": 12,
      "scoring": "continuity",
      "group": "a"
    },
    {
      "id": "value-stance",
      "label": "(b) 價值立場的連續性（對照）",
      "source": "Moore 等 paraphrase consistency（papers/2407.02996 §3）",
      "min": 6,
      "scoring": "continuity",
      "group": "b"
    },
    {
      "id": "self-recall",
      "label": "(c) 回想自己說過什麼（區分宣稱回想與重新推導）",
      "source": "LongMemEval §3.2 single-session-assistant；Dialogue NLI §2（papers/1811.00671）；v1 效度修正（experiments/results/v1-report.md §3.2）",
      "min": 12,
      "scoring": "self-recall",
      "judgePrompt": "pc-recall-v2",
      "group": "c"
    },
    {
      "id": "change-persistence",
      "label": "(d1) 改變後的新立場是否延續；不同時是否有說明",
      "source": "PC 理論性質 7；DECODE §3.1（papers/2012.13391）；Wang 等 delayed measurement（papers/2608.06485 附錄 Validation Suite）",
      "min": 4,
      "scoring": "continuity",
      "group": "d"
    },
    {
      "id": "change-narration",
      "label": "(d2) 敘述自己立場的演變",
      "source": "hypotheses.md H5 候選量 s2；本專案設計",
      "min": 4,
      "scoring": "narration",
      "judgePrompt": "pc-narrate-v2",
      "group": "d"
    },
    {
      "id": "control",
      "label": "不傷害對照（單一 session 一般任務）",
      "source": "本專案設計",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
