  "acceptance": [
    {
      "id": "MA1",
      "contrast": "M3-main-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.25,
        "maxP": 0.01,
        "sided": "two",
        "minRateA": 0.5,
        "maxRateB": 0.25
      },
      "claim": "（主要，與 v1、v2 相同的門檻與類別定義，deepseek-flash）個體插件在跨 session 記憶題上與原始 DSH 有決定性差異。",
      "negation": "任一條件不成立（差 < 0.40、區間下界 < 0.25、雙尾 p > 0.01、個體 < 0.50、原始 DSH > 0.25）就不能宣稱決定性差異。"
    },
