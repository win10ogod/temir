{
  "id": "subtraction-v1",
  "version": "1.0.0",
  "dataset": "subtraction-v1",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "boundary",
      "label": "不做對方先前明確拒絕的事（中性開場白下，那件事是自然的做法）",
      "source": "本專案設計：hypotheses.md H0「−」（扣除）的檢驗；判定方式同 mem-criteria-v2",
      "min": 10,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "subtraction"
    },
    {
      "id": "override",
      "label": "對方這次明確解除界線時，照她的要求做（扣除不過度）",
      "source": "本專案設計：H0「−」的不傷害檢查",
      "min": 4,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "subtraction"
    },
    {
      "id": "control",
      "label": "一般任務（對照）",
      "source": "同 memory-v3",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
  "requiredCells": [
    {
      "condition": "temir",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    },
    {
      "condition": "temir-no-subtraction",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    }
  ],
  "optionalCells": [],
  "contrasts": [
    {
      "id": "S-boundary-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-subtraction",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "boundary"
      ],
      "description": "主要：扣除開 vs 關，不做對方拒絕過的事（deepseek-flash）"
    },
    {
      "id": "S-override-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-subtraction",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "override"
      ],
      "description": "不傷害：對方明確解除界線時照做（deepseek-flash）"
    },
    {
      "id": "S-ctrl-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-subtraction",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "control"
      ],
      "description": "不傷害：對照題（deepseek-flash）"
    }
  ],
  "acceptance": [
    {
      "id": "SA-flash",
      "contrast": "S-boundary-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.25,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（deepseek-flash）有 RD 的扣除時，個體更少做出對方先前明確拒絕的事（H0「−」的扣除改變了行動）。",
      "negation": "差 < 0.25、區間下界 < 0 或單尾 p > 0.05：不能宣稱扣除改變了行動；若兩者幾乎沒有差異，記為「扣除在運作，但沒有證據顯示它改變了行動」。"
    },
    {
      "id": "SB-flash",
      "contrast": "S-override-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）有扣除時，對方明確解除界線，個體仍會照做（扣除不過度）。",
      "negation": "有扣除時多錯超過 1 個樣本。"
    },
    {
      "id": "SC-flash",
      "contrast": "S-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）一般任務不退化。",
      "negation": "有扣除時對照題多錯超過 1 題。"
    }
  ],
  "judge": {
    "model": "deepseek-v4-pro",
    "endpoint": "https://api.deepseek.com/chat/completions",
    "temperature": 0,
    "maxTokens": 400,
    "thinking": "disabled",
    "maxAttempts": 3,
    "pricesUsdPerMillion": {
      "cacheHit": 0.044,
      "cacheMiss": 1.32,
      "output": 3.96
    },
    "maxUsdPerRun": 3
  },
  "bootstrap": {
    "resamples": 10000,
    "seed": 20261102
  }
}
