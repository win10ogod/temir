  "acceptance": [
    {
      "id": "PA1",
      "contrast": "P2-pooled-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.2,
        "maxP": 0.01,
        "sided": "one",
        "minRateA": 0.6
      },
      "claim": "（主要，與 v1 PA1 相同的門檻與類別定義，DeepSeek）個體插件讓依賴記憶的人格連續性與原始 DSH 有決定性差異。",
      "negation": "差 < 0.40、區間下界 < 0.20、單尾符號檢定 p > 0.01、個體 < 0.60，任一成立即不能宣稱。"
    },
    {
      "id": "PA2-EVE",
