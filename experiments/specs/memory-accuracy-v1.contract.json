  "acceptance": [
    {
      "id": "MA1",
      "contrast": "M-main-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.25,
        "maxP": 0.01,
        "sided": "two",
        "minRateA": 0.5,
        "maxRateB": 0.25
      },
      "claim": "（主要，DeepSeek）個體插件在跨 session 記憶題上與原始 DSH 有決定性差異。",
      "negation": "任一條件不成立（差 < 0.40、區間下界 < 0.25、雙尾 p > 0.01、個體正確率 < 0.50 或原始 DSH > 0.25），就不能宣稱決定性差異。"
    },
    {
      "id": "MA2",
      "contrast": "M-main-eve",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.4,
        "minCiLow": 0.25,
        "maxP": 0.01,
        "sided": "two",
        "minRateA": 0.5,
        "maxRateB": 0.25
      },
      "claim": "（主要，本機 EVE-27B）同 MA1。",
      "negation": "同 MA1。兩個模型結果不同時，分開報告，不合併成單一結論。"
    },
    {
      "id": "MA3",
      "contrast": "M-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（不傷害，DeepSeek）個體插件不讓單一 session 的一般任務退化。",
      "negation": "個體在對照題的失敗數比原始 DSH 多 2 題以上，即判定可能有害，需逐例檢查原始回答。"
    },
    {
      "id": "MA4",
      "contrast": "M-ctrl-eve",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（不傷害，EVE-27B）同 MA3。",
      "negation": "同 MA3。"
    },
    {
      "id": "MA5",
      "contrast": "M-abs-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（虛構記憶，DeepSeek）個體不會因為有記憶而更常順著錯誤前提編造答案。",
      "negation": "個體在拒答題的失敗數比原始 DSH 多 2 題以上（4 題中），即判定記憶造成虛構。"
    },
    {
      "id": "MA6",
      "contrast": "M-abs-eve",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（虛構記憶，EVE-27B）同 MA5。",
      "negation": "同 MA5。"
    },
    {
      "id": "MA7",
      "contrast": "M-autorecall-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.2,
        "minCiLow": 0.05,
        "maxP": 0.05,
        "sided": "two"
      },
      "claim": "（次要）自動回憶是記憶表現的必要來源（只靠主動 recall 工具不夠）。",
      "negation": "不成立時只能說「沒有證據顯示自動回憶必要」，不能反過來宣稱它沒有作用。"
    }
