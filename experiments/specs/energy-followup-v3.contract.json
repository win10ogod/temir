{
  "id": "energy-followup-v3",
  "version": "3.0.0",
  "dataset": "followup-v3",
  "kind": "memory",
  "reportVersion": 2,
  "protocol": {
    "layout": "home",
    "infraErrorPattern": "\\b(?:429|502|503|504)\\b|rate[ _-]?limit|too many requests|free-models-per|quota|overloaded|provider returned error"
  },
  "descriptive": {
    "sessionStorePattern": "\\.dsh\\b|dsh[-_]home|session\\.v4|\\.jsonl\\.zstd|session_projcache",
    "lifeLogPattern": "life\\.db|\\.local[\\\\/]share[\\\\/]temir"
  },
  "categories": [
    {
      "id": "follow-through",
      "label": "追蹤懸著的事（中性開場白下，主動提起或兌現還沒結束的事）",
      "source": "本專案設計：hypotheses.md H-E 的推翻條件；判定方式同 mem-criteria-v2",
      "min": 8,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "energy"
    },
    {
      "id": "restraint",
      "label": "不把已經結束的事當成還沒結束",
      "source": "本專案設計：H-E 的「釋放」",
      "min": 4,
      "scoring": "judge-criteria",
      "judgePrompt": "mem-criteria-v2",
      "group": "energy"
    },
    {
      "id": "control",
      "label": "一般任務（對照）",
      "source": "同 memory-v3",
      "min": 4,
      "scoring": "det-then-judge",
      "judgePrompt": "mem-default",
      "group": "control"
    }
  ],
  "requiredCells": [
    {
      "condition": "temir",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    },
    {
      "condition": "temir-no-energy",
      "historyModel": "deepseek-flash",
      "probeModel": "deepseek-flash"
    }
  ],
  "optionalCells": [],
  "contrasts": [
    {
      "id": "E-follow-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-energy",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "follow-through"
      ],
      "description": "主要：能量開 vs 關，追蹤懸著的事（deepseek-flash）"
    },
    {
      "id": "E-restraint-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-energy",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "restraint"
      ],
      "description": "不把結束的事當成還沒結束（deepseek-flash）"
    },
    {
      "id": "E-ctrl-flash",
      "a": {
        "condition": "temir",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "b": {
        "condition": "temir-no-energy",
        "historyModel": "deepseek-flash",
        "probeModel": "deepseek-flash"
      },
      "categories": [
        "control"
      ],
      "description": "不傷害：對照題（deepseek-flash）"
    }
  ],
  "acceptance": [
    {
      "id": "EA-flash",
      "contrast": "E-follow-flash",
      "rule": {
        "kind": "superiority",
        "minDiff": 0.25,
        "minCiLow": 0,
        "maxP": 0.05,
        "sided": "one"
      },
      "claim": "（deepseek-flash）有能量（第三版之一）時，個體在中性開場白下更常主動追蹤還沒結束的事（H-E 的推翻條件不成立）。",
      "negation": "差 < 0.25、區間下界 < 0 或單尾 p > 0.05：不能宣稱能量參與了追蹤承諾的行為；若兩者幾乎沒有差異，依 H-E 的推翻條件記為「沒有證據支持」。"
    },
    {
      "id": "EB-flash",
      "contrast": "E-restraint-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）有能量（第三版之一）時，不會更常把已經結束的事當成還沒結束。",
      "negation": "有能量時多錯超過 1 個樣本。"
    },
    {
      "id": "EC-flash",
      "contrast": "E-ctrl-flash",
      "rule": {
        "kind": "no-harm",
        "maxExtraFailures": 1
      },
      "claim": "（deepseek-flash）一般任務不退化。",
      "negation": "有能量時對照題多錯超過 1 題。"
    }
  ],
  "judge": {
    "model": "deepseek-v4-pro",
    "endpoint": "https://api.deepseek.com/chat/completions",
    "temperature": 0,
    "maxTokens": 400,
    "thinking": "disabled",
    "maxAttempts": 3,
    "pricesUsdPerMillion": {
      "cacheHit": 0.044,
      "cacheMiss": 1.32,
      "output": 3.96
    },
    "maxUsdPerRun": 3
  },
  "bootstrap": {
    "resamples": 10000,
    "seed": 20261101
  }
}
